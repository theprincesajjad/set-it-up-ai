# Everything is optional in development: without credentials the API uses an
# in-process Postgres (PGlite) and console providers that log SMS/email/push.
NODE_ENV=development
PORT=4000
# postgres://user:pass@host:5432/db  |  pglite://memory  |  pglite://./.pglite/dev
DATABASE_URL=pglite://./.pglite/dev
JWT_SECRET=
# 64 hex chars (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ACTIVATION_THRESHOLD=25
JOBS=1

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Local Loyalty <hello@localloyalty.example>
# Push (Expo)
EXPO_ACCESS_TOKEN=

# Stripe (subscriptions + Connect payments)
STRIPE_SECRET_KEY=
# Platform and Connect endpoint secrets, comma-separated
STRIPE_WEBHOOK_SECRET=
# Charge on the shop's own Stripe account for merchants set to chargeMode "direct" (default off)
STRIPE_DIRECT_CHARGES=
# Stripe Tax on our own subscription checkouts (plans, restaurant tiers): collects GST/HST and a billing address.
# Needs Stripe Tax registrations first, see docs/engineering/stripe-go-live.md (default off)
STRIPE_AUTOMATIC_TAX=
# Allow Canadian pre-authorized debit (ACSS) for tiffin
TIFFIN_PAD=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# POS connectors
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENV=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_ENV=sandbox
# Shown in the Clover developer dashboard after the webhook verification handshake
CLOVER_WEBHOOK_AUTH_CODE=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_WEBHOOK_SECRET=
# https://ws-api.toasttab.com in production
TOAST_API_HOST=https://ws-sandbox-api.eng.toasttab.com

# Marketing connectors
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# Wallet passes
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PEM=
# APNs token auth for pass updates (Apple Developer → Keys → APNs). Falls back to the pass certificate.
APPLE_APNS_KEY_ID=
# Contents of AuthKey_<KEYID>.p8 (PEM; \n escapes accepted)
APPLE_APNS_KEY_P8=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_PLACES_API_KEY=
# Proxy hops to trust for the client IP (X-Forwarded-For). Production default 1 (the load balancer); `true` trusts every hop.
TRUST_PROXY_HOPS=
# Where rate-limit counters live. `memory` (default): per API process, so with N instances the effective limit is up to N times
# higher. `postgres`: one shared table (rate_limit_counters), one limit across instances; adds one upsert per request for the
# blanket cap, so turn it on only when you run more than one instance.
RATE_LIMIT_STORE=memory
# After-commit outbox (notifications, wallet pass pushes, onboarding milestones, ad attribution after a stamp).
# OUTBOX_FAST_PATH=0 leaves delivery to the `outbox.drain` job (every 5 s, needs JOBS=1 somewhere); OUTBOX_INLINE=1 delivers before the
# request returns (tests do; do not use in production).
OUTBOX_FAST_PATH=1
OUTBOX_INLINE=

# File storage (repair photos, exports). STORAGE_PROVIDER=r2|disk|memory. Default: disk in development, memory in tests.
# Production: r2 (Cloudflare R2, S3 API). Setup, CORS and lifecycle rules: docs/engineering/storage-go-live.md.
STORAGE_PROVIDER=
# disk: where files go (default ./data/uploads)
UPLOADS_DIR=
# r2: all four are required. Keys come from R2 > Manage API tokens (Object Read & Write, scoped to this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. A jurisdiction endpoint (https://<account>.eu.r2.cloudflarestorage.com) when the bucket was created with one.
R2_ENDPOINT=
# Optional. Public custom domain of the bucket, used only for the URL returned when a file is stored. Leave empty: photos stay private
# and are always read through presigned links that expire (UPLOAD_LINK_MINUTES).
R2_PUBLIC_BASE=

# Sales and support assistant (our own AI agent on the platform WhatsApp number and the website chat).
# ANTHROPIC_API_KEY turns it on; without it the chat opens, says it is an AI and hands every message to a person (/admin/sales-agent).
ANTHROPIC_API_KEY=
# claude-opus-5-5 by default; SALES_AGENT_EFFORT low|medium|high (low is right for chat); SALES_AGENT_FALLBACKS=0 turns off the server-side safety fallback.
SALES_AGENT_MODEL=
SALES_AGENT_EFFORT=
SALES_AGENT_FALLBACKS=
# The platform WhatsApp number (not a shop's): display number, and Meta's phone number id for it. Unset = no WhatsApp door.
SALES_AGENT_WHATSAPP_NUMBER=
SALES_AGENT_WHATSAPP_PHONE_NUMBER_ID=
# 0 switches the assistant off entirely.
SALES_AGENT_ENABLED=
# Who is emailed on a hand-off or a founder-call request. Default: the support address.
SALES_AGENT_ADMIN_EMAIL=
# Only when the API ships without the repo's docs/ folder: where sales/agent-faq.md and legal/*.md are read from.
DOCS_DIR=
