# Copy to .env.local (Expo loads it automatically). Only EXPO_PUBLIC_* reach the JS bundle.
# Simulator on the same machine as the API:
EXPO_PUBLIC_API_URL=http://localhost:4000
# Android emulator: http://10.0.2.2:4000 · Physical device: http://<your-LAN-IP>:4000
# Preview and production builds REQUIRE real values (the build fails on a missing or placeholder host); set them in the EAS environment:
# EXPO_PUBLIC_API_URL=https://<api host>
# EXPO_PUBLIC_WEB_URL=https://<web host>   (terms, privacy, share links, universal links)
# EXPO_PUBLIC_SUPPORT_EMAIL=<monitored support address>
# Optional
# EAS_PROJECT_ID=
# GOOGLE_MAPS_API_KEY=
