{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.ts",
    "*.mts",
    ".next-webv2/types/**/*.ts",
    ".next-webv2/dev/types/**/*.ts",
    ".next-dash/types/**/*.ts",
    ".next-dash/dev/types/**/*.ts",
    ".next-polish/types/**/*.ts",
    ".next-polish/dev/types/**/*.ts",
    ".next-lead/types/**/*.ts",
    ".next-lead/dev/types/**/*.ts",
    ".next-canvas/types/**/*.ts",
    ".next-canvas/dev/types/**/*.ts",
    ".next-rest2/types/**/*.ts",
    ".next-rest2/dev/types/**/*.ts",
    ".next-rest4/types/**/*.ts",
    ".next-rest4/dev/types/**/*.ts",
    ".next-rest1/types/**/*.ts",
    ".next-rest1/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-rqa/types/**/*.ts",
    ".next-rqa/dev/types/**/*.ts",
    ".next-rqa-tc/types/**/*.ts",
    ".next-rqa-tc/dev/types/**/*.ts",
    ".next-mkt/types/**/*.ts",
    ".next-mkt/dev/types/**/*.ts",
    ".next-cafe/types/**/*.ts",
    ".next-cafe/dev/types/**/*.ts",
    ".next-desi1/types/**/*.ts",
    ".next-desi1/dev/types/**/*.ts",
    ".next-tcb/types/**/*.ts",
    ".next-tcb/dev/types/**/*.ts",
    ".next-appts/types/**/*.ts",
    ".next-appts/dev/types/**/*.ts",
    ".next-vqa/types/**/*.ts",
    ".next-vqa/dev/types/**/*.ts",
    ".next-onb/types/**/*.ts",
    ".next-onb/dev/types/**/*.ts",
    ".next-ops/types/**/*.ts",
    ".next-ops/dev/types/**/*.ts",
    ".next-shop/types/**/*.ts",
    ".next-shop/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
