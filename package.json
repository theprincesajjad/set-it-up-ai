{
  "name": "local-loyalty",
  "private": true,
  "version": "0.1.0",
  "description": "Local Loyalty — a free, shared loyalty network for independent neighbourhood businesses.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "dev:api": "pnpm --filter @ll/api dev",
    "dev:web": "pnpm --filter @ll/web dev",
    "dev:mobile": "pnpm --filter @ll/mobile start",
    "db:generate": "pnpm --filter @ll/db generate",
    "db:migrate": "pnpm --filter @ll/db migrate",
    "db:seed": "pnpm --filter @ll/api seed",
    "l10n:scan": "node scripts/l10n-scan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
