{
  "name": "@ll/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for Local Loyalty: colours, type, spacing, motion, verticals. TS for React Native, CSS + Tailwind v4 @theme for web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/tokens.css": "./css/tokens.css",
    "./css/theme.css": "./css/theme.css",
    "./tokens.css": "./css/tokens.css",
    "./theme.css": "./css/theme.css"
  },
  "files": [
    "src",
    "css"
  ],
  "scripts": {
    "build": "tsx src/build-css.ts",
    "build:css": "tsx src/build-css.ts",
    "check:css": "tsx src/build-css.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ll/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
