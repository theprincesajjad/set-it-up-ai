{
  "name": "@ll/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for Local Loyalty (v2, docs/design/foundations.md): colours, type, spacing, motion, map style, category icons. TS for React Native, CSS + Tailwind v4 @theme for web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/tokens.css": "./css/tokens.css",
    "./css/theme.css": "./css/theme.css",
    "./tokens.css": "./css/tokens.css",
    "./theme.css": "./css/theme.css",
    "./map/corner-light.json": "./map/corner-light.json",
    "./map/corner-dark.json": "./map/corner-dark.json",
    "./icons3d.css": "./css/icons3d.css",
    "./css/icons3d.css": "./css/icons3d.css",
    "./assets/categories/*": "./assets/categories/*",
    "./assets/icons3d/*": "./assets/icons3d/*"
  },
  "files": [
    "src",
    "css",
    "map",
    "assets"
  ],
  "scripts": {
    "build": "tsx src/build-css.ts && node scripts/icons3d.mjs",
    "lint:icons3d": "node scripts/icons3d.mjs --lint",
    "build:css": "tsx src/build-css.ts",
    "check:css": "tsx src/build-css.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "render:icons": "node scripts/render-categories.cjs"
  },
  "dependencies": {
    "@ll/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
