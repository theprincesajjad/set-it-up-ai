# Local Loyalty: configuration for docker-compose.yml (cp .env.example .env, never commit .env).
# Full walkthrough: docs/engineering/deploy.md. Reads of these variables: apps/api/src/config.ts, apps/web/src/lib/env.ts.
#
# Rules of this file:
#  - REQUIRED lines are uncommented: fill them in.
#  - RECOMMENDED and OPTIONAL lines are commented out. Uncomment only the ones you set: an uncommented empty line (FOO=) reaches the
#    container as an empty string, which is NOT the same as unset for settings that use a default.
#  - No quotes and no spaces around "=". Generate secrets with the commands shown.
#  - Production (NODE_ENV=production, which compose sets) refuses to start without JWT_SECRET, ENCRYPTION_KEY, a real file store
#    (STORAGE_PROVIDER=disk or r2, never memory), and Twilio SMS (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_MESSAGING_SERVICE_SID
#    or TWILIO_FROM) unless ALLOW_CONSOLE_SMS=1, which is for a staging server that reads sign-in codes from `docker compose logs api`.

# =====================================================================================================================
# REQUIRED
# =====================================================================================================================

# Postgres container credentials (compose builds DATABASE_URL from these). Use hex so no character needs URL-escaping: openssl rand -hex 24
# Without POSTGRES_PASSWORD compose refuses to start. Changing it later does not change an existing volume's password.
POSTGRES_PASSWORD=
# Optional names, shown with their defaults:
# POSTGRES_USER=ll
# POSTGRES_DB=ll

# Signs every access and refresh token (jose, HS256). At least 32 random characters: openssl rand -base64 48
# Without it production refuses to start. Changing it signs everyone out.
JWT_SECRET=

# 32-byte key, 64 hex characters, encrypts POS connector credentials at rest: openssl rand -hex 32
# Without it production refuses to start. LOSING OR CHANGING IT makes stored connector tokens unreadable: keep a copy in your secret manager.
ENCRYPTION_KEY=

# Public URL of the API (no trailing slash). Used for webhook URLs, OAuth redirects, upload links and emailed links.
# Without it the API assumes http://localhost:4000 and every link it emails or registers with Stripe is wrong.
PUBLIC_API_URL=http://localhost:4000

# Public URL of the web app (no trailing slash). Used for links in emails/SMS/wallet passes and Stripe return URLs.
# Without it the API assumes http://localhost:3000.
PUBLIC_WEB_URL=http://localhost:3000

# Browser origins allowed to call the API (comma-separated, exact scheme+host+port, no trailing slash): the web app's public URL
# and, for the mobile web build, its origin. In production any other origin is blocked by CORS: sign-in, the dashboard's
# browser calls and the pass page all fail from an unlisted origin. Default: http://localhost:3000,http://localhost:8081
CORS_ORIGINS=http://localhost:3000

# BAKED INTO THE WEB IMAGE AT BUILD TIME (compose passes them as build args; run `docker compose build web` after changing them):
# public URL of the API as the browser reaches it. Without it the browser calls http://localhost:4000 (the visitor's own machine).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of the web app: canonical links, sitemap, Open Graph. Without it: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where uploads (repair photos) live: disk (a docker volume, single host) or r2 (Cloudflare R2; see docs/engineering/storage-go-live.md).
# `memory` is refused in production. Compose mounts the `uploads` volume at /data/uploads for disk.
STORAGE_PROVIDER=disk

# SMS (sign-in codes, reminders). Required in production unless ALLOW_CONSOLE_SMS=1. Without Twilio no customer can sign in:
# the code is only printed in the API log. Provide the sid, the token and ONE of the messaging service sid or the from number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM=+14165550100
# Staging only: accept console SMS in production. Codes are read from `docker compose logs api`. Never on a public launch.
# ALLOW_CONSOLE_SMS=1

# =====================================================================================================================
# RECOMMENDED
# =====================================================================================================================

# Host ports compose publishes (container ports are fixed: api 4000, web 3000, postgres 5432). Postgres binds 127.0.0.1 only.
# API_PORT=4000
# WEB_PORT=3000
# POSTGRES_PORT=5432

# Number of reverse proxies in front of the API (X-Forwarded-For hops). Default in production: 1. Too low: every client looks like the
# proxy and shares one rate-limit bucket. Too high: callers can forge their address. 0 with no proxy at all; `true` trusts every hop (don't).
# TRUST_PROXY_HOPS=1

# Where rate-limit counters live. `memory` (default) is per API process, fine for ONE instance. `postgres`: one shared limit across
# instances (REQUIRED once you run more than one API replica; the ratelimit.sweep job cleans it up).
# RATE_LIMIT_STORE=postgres

# Background jobs (scheduled messages, reminders, outbox retries, ad pacing, retention). JOBS=0 turns them OFF in this process;
# anything else (including unset) turns them ON. Exactly one API instance must have them on. Compose runs one API, so leave unset.
# JOBS=0

# Email (Resend). Without it emails are only printed in the API log: no receipts, no invites, no campaigns.
# RESEND_API_KEY=
# EMAIL_FROM=Local Loyalty <hello@your-domain.example>

# Push (Expo). Without a token pushes are only logged. EXPO_PUSH=1 uses Expo's unauthenticated service.
# EXPO_ACCESS_TOKEN=
# EXPO_PUSH=1

# Stripe billing and payments (docs/engineering/stripe-go-live.md). Without the secret key paid plans and card payments are off.
# STRIPE_SECRET_KEY=
# whsec_ signing secret(s) of the webhook endpoint(s), comma-separated (platform and Connect). Without it webhooks are rejected.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS_MONTHLY=
# STRIPE_PRICE_PLUS_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# BAKED INTO THE WEB IMAGE at build time: Stripe publishable key (pk_...). Without it checkout shows the fake dev payment path.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (when STORAGE_PROVIDER=r2): all four are required then, startup fails naming the missing one.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# =====================================================================================================================
# OPTIONAL (every one has a safe default; unset means the feature is off or uses the default shown)
# =====================================================================================================================

# --- API: core tuning
# Active members before a shop counts as "activated" (default 25).
# ACTIVATION_THRESHOLD=25
# Disk storage directory inside the container (default /data/uploads, which is the compose volume).
# UPLOADS_DIR=/data/uploads
# R2: custom endpoint (jurisdiction bucket) and public base. Leave R2_PUBLIC_BASE unset: photos must stay behind expiring links.
# R2_ENDPOINT=
# R2_PUBLIC_BASE=
# Signup address pin lookup. Production default: nominatim (OpenStreetMap, one request per signup). none = no lookup, no map pin.
# GEOCODER_PROVIDER=none
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=YourApp/1.0 (contact@your-domain.example)
# Notification outbox: 0 leaves all delivery to the outbox.drain job (a few seconds later). OUTBOX_INLINE=1 delivers inside the request (tests; not for production).
# OUTBOX_FAST_PATH=1
# OUTBOX_INLINE=
# Dead-link guard: misses per address per 10 minutes before slowing down (default 40).
# MISS_LIMIT=40
# Number of demo customers the seed creates (default: the seed's own).
# SEED_CUSTOMERS=

# --- API: sales and support assistant. Without ANTHROPIC_API_KEY the chat opens, discloses it is an AI and hands every message to /admin/sales-agent.
# ANTHROPIC_API_KEY=
# SALES_AGENT_MODEL=claude-opus-5-5
# SALES_AGENT_EFFORT=low
# SALES_AGENT_FALLBACKS=0
# SALES_AGENT_ENABLED=0
# SALES_AGENT_ADMIN_EMAIL=
# Platform WhatsApp number (display) and Meta's phone number id for it. Unset: no WhatsApp door.
# SALES_AGENT_WHATSAPP_NUMBER=
# SALES_AGENT_WHATSAPP_PHONE_NUMBER_ID=
# Only if the API runs without the repo's docs/ folder (the Docker image bundles what it needs at /app/docs).
# DOCS_DIR=

# --- API: WhatsApp Cloud API (Meta). Without the access token a fake provider is used (nothing is sent).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# Phone ordering webhook signature token (falls back to TWILIO_AUTH_TOKEN). Without either, unsigned calls are accepted only outside production.
# PHONE_WEBHOOK_AUTH_TOKEN=

# --- API: Stripe extras
# Charge on the merchant's own Stripe account for merchants set to direct charges (default off).
# STRIPE_DIRECT_CHARGES=1
# Stripe Tax on our own subscription checkouts (needs Stripe Tax registrations first; default off).
# STRIPE_AUTOMATIC_TAX=1
# Pre-authorized debit for tiffin subscriptions (default off).
# TIFFIN_PAD=1

# --- API: POS and marketing connectors (each pair/trio enables that connector; unset = the connector shows as unavailable). docs/engineering/connectors.md
# SQUARE_APP_ID=
# SQUARE_APP_SECRET=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_ENV=production
# CLOVER_APP_ID=
# CLOVER_APP_SECRET=
# CLOVER_WEBHOOK_AUTH_CODE=
# CLOVER_ENV=production
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# LIGHTSPEED_CLIENT_ID=
# LIGHTSPEED_CLIENT_SECRET=
# TOAST_CLIENT_ID=
# TOAST_CLIENT_SECRET=
# TOAST_WEBHOOK_SECRET=
# TOAST_API_HOST=https://ws-api.toasttab.com
# MAILCHIMP_CLIENT_ID=
# MAILCHIMP_CLIENT_SECRET=

# --- API: wallet passes. Without them the "Add to Apple/Google Wallet" buttons are unavailable.
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_PEM=
# APPLE_APNS_KEY_ID=
# APPLE_APNS_KEY_P8=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Google Places key for the shop address picker (without it that picker is off).
# GOOGLE_PLACES_API_KEY=

# --- Web: read at RUN time by the web container
# Where the web server reaches the API on the private network (compose default http://api:4000). Without it the web server would
# use NEXT_PUBLIC_API_URL, i.e. go out through the public internet and back.
# API_INTERNAL_URL=http://api:4000
# Demo only: fills the sign-in code box from the API's devCode. Production APIs never send a devCode, so this does nothing useful there.
# OTP_AUTOFILL=1

# --- Web: BAKED INTO THE WEB IMAGE at build time
# "Get the app" links (default: the store home pages).
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=
# Digits, international format, behind "Message us on WhatsApp"; keep equal to SALES_AGENT_WHATSAPP_NUMBER. Unset: the buttons are hidden.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# MapLibre style URL for the map (default: a free OpenStreetMap-based style, no key).
# NEXT_PUBLIC_MAP_STYLE_URL=
# 1 once you have Apple's/Google's official wallet badge artwork in place.
# NEXT_PUBLIC_WALLET_BADGES=1

# Image/tooling knobs
# NODE_IMAGE=node:22-slim
# POSTGRES_IMAGE=postgres:16
# IMAGE_TAG=latest
